<ContentPage x:Class="SanskarConnectX.Mobile.Pages.WifiProvisioningPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
  <VerticalStackLayout Padding="24" Spacing="12">
    <Label Text="Wi-Fi provisioning" FontSize="28" FontAttributes="Bold" />
    <Entry Placeholder="Network name" />
    <Entry Placeholder="Password" IsPassword="True" />
    <Button Text="Send to device" />
  </VerticalStackLayout>
</ContentPage>

