<section class="panel">
  <div class="panel-header">
    <h2>Devices</h2>
    <span>@Devices.Count active rows</span>
  </div>
  <table class="device-table">
    <thead>
      <tr>
        <th>Device</th>
        <th>State</th>
        <th>RSSI</th>
        <th>Firmware</th>
        <th>Last seen</th>
      </tr>
    </thead>
    <tbody>
      @foreach (var device in Devices)
      {
        <tr>
          <td>
            <strong>@device.DisplayName</strong>
            <span>@device.DeviceId</span>
          </td>
          <td><span class="badge @(device.State == "Online" ? "online" : "warning")">@device.State</span></td>
          <td>@device.Rssi dBm</td>
          <td>@device.FirmwareVersion</td>
          <td>@device.LastSeenUtc.ToLocalTime().ToString("HH:mm:ss")</td>
        </tr>
      }
    </tbody>
  </table>
</section>

@code {
    [Parameter]
    public IReadOnlyList<DeviceDashboardRow> Devices { get; set; } = Array.Empty<DeviceDashboardRow>();
}
